{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MuxAgent",
  "version": "0.1.0",
  "identifier": "com.lalanmo.muxagentdesktop",
  "build": {
    "beforeDevCommand": "tsx scripts/tauri-dev-web.ts",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MuxAgent",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 720,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 16
        }
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon-32x32.png",
      "icons/icon-128x128.png",
      "icons/icon-256x256.png",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
