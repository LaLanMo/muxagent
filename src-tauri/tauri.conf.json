{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MuxAgent",
  "version": "0.1.0",
  "identifier": "com.lalanmo.muxagentdesktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MuxAgent",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
