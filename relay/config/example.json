{
  "database": {
    "host": "localhost",
    "port": 15432,
    "user": "postgres",
    "password": "root",
    "dbname": "muxagent",
    "sslmode": "disable"
  },
  "relay": {
    "public_base_url": "http://127.0.0.1:8080",
    "listen_addr": ":8080"
  },
  "firebase": {
    "credentials_file": ""
  },
  "http": {
    "read_header_timeout_sec": 5,
    "read_timeout_sec": 15,
    "write_timeout_sec": 30,
    "idle_timeout_sec": 60,
    "max_header_bytes": 16384,
    "max_json_body_bytes": 65536
  },
  "rate_limit": {
    "auth_create_per_ip_per_min": 20,
    "read_per_ip_per_min": 200,
    "write_per_ip_per_min": 60,
    "ws_upgrade_per_ip_per_min": 30,
    "max_ws_conns_per_ip": 50,
    "max_ws_conns_total": 5000,
    "ws_inbound_bytes_per_conn_per_min": 52428800,
    "ws_register_timeout_sec": 10,
    "trusted_proxies": []
  }
}
